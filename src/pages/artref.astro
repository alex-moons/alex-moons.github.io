---
import Layout from '../layouts/ArtRef.astro';
import '../styles/artref.scss';
import { Icon } from "astro-icon/components";
---

<Layout>
	<div class="testing-page">
		<header class="topbar">
			<a class="brand" href="/" aria-label="Home"><span class="brand-mark">></span><span>Home</span></a>
			<nav aria-label="Main navigation"><a href="/">Home</a><a class="current" href="/ArtRef">ArtRef</a></nav>
			<span class="edition">Useful Tools · 01</span>
		</header>

		<main>
			<section class="toolbox-section" aria-labelledby="toolbox-title">
				<div class="section-heading">
					<h2 id="toolbox-title">ArtRef</h2>
				</div>
				<p class="section-heading">Start drag-n-dropping, pasting or uploading images. ArtRef supports all major image formats and even works with image urls.</p>
				<!-- <button class="btn-annoying">Test</button>
				<a class="link-annoying" href="https://alexmoons.dev/testing" target="_blank" rel="noopener noreferrer">Link</a> -->

				<div class="artref-container">
					<button class="clipboard-paste" id="clipboard-paste" type="button">Paste or add images <Icon name="paste"/></button>
					<div class="artref-board" id="artref-board" aria-label="Image reference board">
						<!-- Images will be added here -->
					</div>
					<div class="artref-controls">
						<input type="file" id="artref-file-input" accept="image/*" multiple />
						<label for="artref-background-color">Board background <input type="color" id="artref-background-color" value="#808080" /></label>
						<button id="artref-export-button" type="button">Export reference</button>
						<button id="artref-clear-button" type="button">Clear Board</button>
					</div>
				</div>
				<dialog id="artref-export-dialog" aria-labelledby="artref-export-title">
					<h3 id="artref-export-title">Export reference</h3>
					<label for="artref-export-quality">Quality</label>
					<select id="artref-export-quality">
						<option value="low">Low</option>
						<option value="medium" selected>Medium</option>
						<option value="original">Original</option>
					</select>
					<label for="artref-export-format">Format</label>
					<select id="artref-export-format">
						<option value="png">PNG (transparent)</option>
						<option value="jpeg">JPEG (board background)</option>
					</select>
					<p id="artref-export-status" role="status" aria-live="polite"></p>
					<div class="artref-export-actions">
						<button id="artref-download-button" type="button">Download</button>
						<button id="artref-copy-button" type="button">Copy to clipboard</button>
						<button id="artref-export-close" type="button">Close</button>
					</div>
				</dialog>

			</section>
		</main>

		<footer><span>Made by Alex Moons</span><a href="/">Back Home ↗</a></footer>
	</div>
</Layout>

<script>
	const board = document.getElementById('artref-board');
	const fileInput = document.getElementById('artref-file-input') as HTMLInputElement | null;
	const clipboardPasteButton = document.getElementById('clipboard-paste');
	const clearButton = document.getElementById('artref-clear-button');
	const backgroundInput = document.getElementById('artref-background-color') as HTMLInputElement | null;
	const exportButton = document.getElementById('artref-export-button');
	const exportDialog = document.getElementById('artref-export-dialog') as HTMLDialogElement | null;
	const qualityInput = document.getElementById('artref-export-quality') as HTMLSelectElement | null;
	const formatInput = document.getElementById('artref-export-format') as HTMLSelectElement | null;
	const exportStatus = document.getElementById('artref-export-status');
	const downloadButton = document.getElementById('artref-download-button');
	const copyButton = document.getElementById('artref-copy-button');
	const closeExportButton = document.getElementById('artref-export-close');
	let draggedTile: HTMLDivElement | null = null;
	let activePointerId: number | null = null;
	let pointerMoved = false;
	let pointerStart = { x: 0, y: 0 };

	function updateBoardLayout() {
		if (!board) return;

		const tiles = Array.from(board.querySelectorAll('.artref-tile')) as HTMLDivElement[];
		const count = tiles.length;
		if (count === 0) {
			board.style.removeProperty('--board-columns');
			tiles.forEach((tile) => tile.style.removeProperty('grid-column-start'));
			return;
		}

		const columns = Math.ceil(Math.sqrt(count));
		const remainder = count % columns;
		const firstRowOffset = remainder === 0 ? 0 : Math.ceil((columns - remainder) / 2);
		board.style.setProperty('--board-columns', String(columns));
		tiles.forEach((tile) => tile.style.removeProperty('grid-column-start'));
		if (firstRowOffset > 0) tiles[0].style.gridColumnStart = String(firstRowOffset + 1);
	}

	function addImage(image: Blob) {
		if (!board || !image.type.startsWith('image/')) return;

		const tile = document.createElement('div');
		tile.className = 'artref-tile';
		const img = document.createElement('img');
		img.src = URL.createObjectURL(image);
		img.alt = image instanceof File ? image.name : 'Pasted image';
		img.draggable = false;
		const dragHandle = document.createElement('button');
		dragHandle.className = 'artref-drag-handle';
		dragHandle.type = 'button';
		dragHandle.setAttribute('aria-label', `Drag to reorder ${img.alt}`);
		dragHandle.textContent = '↕';
		tile.append(img, dragHandle);
		board.appendChild(tile);
		updateBoardLayout();
	}

	function addFiles(files: FileList | File[]) {
		Array.from(files).forEach(addImage);
	}

	fileInput?.addEventListener('change', () => {
		if (fileInput.files) addFiles(fileInput.files);
		fileInput.value = '';
	});

	clipboardPasteButton?.addEventListener('click', async () => {
		try {
			const clipboardItems = await navigator.clipboard.read();
			let foundImage = false;

			for (const item of clipboardItems) {
				const imageType = item.types.find((type) => type.startsWith('image/'));
				if (imageType) {
					addImage(await item.getType(imageType));
					foundImage = true;
				}
			}

			if (!foundImage) fileInput?.click();
		} catch {
			fileInput?.click();
		}
	});

	document.addEventListener('paste', (event) => {
		const items = Array.from(event.clipboardData?.items ?? []);
		const imageItems = items.filter((item) => item.type.startsWith('image/'));
		if (imageItems.length === 0) return;

		event.preventDefault();
		imageItems.forEach((item) => {
			const image = item.getAsFile();
			if (image) addImage(image);
		});
	});

	board?.addEventListener('dragover', (event) => {
		event.preventDefault();
		board.classList.add('is-dragging');
	});

	board?.addEventListener('dragleave', () => {
		board.classList.remove('is-dragging');
	});

	board?.addEventListener('drop', (event) => {
		event.preventDefault();
		board.classList.remove('is-dragging');
		if (event.dataTransfer?.files) addFiles(event.dataTransfer.files);
	});

	clearButton?.addEventListener('click', () => {
		board?.querySelectorAll('img').forEach((img) => URL.revokeObjectURL(img.src));
		board?.replaceChildren();
		updateBoardLayout();
	});

	backgroundInput?.addEventListener('input', () => {
		if (board) board.style.backgroundColor = backgroundInput.value;
	});

	function finishReordering(event: PointerEvent, reorder: boolean) {
		if (!board || !draggedTile || event.pointerId !== activePointerId) return;

		const tile = draggedTile;
		tile.classList.remove('is-reordering');
		tile.style.removeProperty('transform');
		draggedTile = null;
		activePointerId = null;
		board.classList.remove('is-reordering');

		if (!reorder || !pointerMoved) {
			pointerMoved = false;
			return;
		}

		const targets = Array.from(board.querySelectorAll('.artref-tile')).filter((candidate) => candidate !== tile) as HTMLDivElement[];
		const nearest = targets.reduce<HTMLDivElement | null>((closest, candidate) => {
			if (!closest) return candidate;
			const rect = candidate.getBoundingClientRect();
			const closestRect = closest.getBoundingClientRect();
			const distance = Math.hypot(event.clientX - (rect.left + rect.width / 2), event.clientY - (rect.top + rect.height / 2));
			const closestDistance = Math.hypot(event.clientX - (closestRect.left + closestRect.width / 2), event.clientY - (closestRect.top + closestRect.height / 2));
			return distance < closestDistance ? candidate : closest;
		}, null);

		if (nearest) {
			const rect = nearest.getBoundingClientRect();
			const offsetX = (event.clientX - (rect.left + rect.width / 2)) / rect.width;
			const offsetY = (event.clientY - (rect.top + rect.height / 2)) / rect.height;
			const insertAfter = Math.abs(offsetX) > Math.abs(offsetY) ? offsetX > 0 : offsetY > 0;
			board.insertBefore(tile, insertAfter ? nearest.nextElementSibling : nearest);
		}
		pointerMoved = false;
		updateBoardLayout();
	}

	board?.addEventListener('pointerdown', (event) => {
		if (!(event.target instanceof Element) || event.button !== 0) return;
		const target = event.target;
		const tile = target.closest('.artref-tile');
		const dragHandle = target.closest('.artref-drag-handle');
		if (!tile || (event.pointerType === 'touch' && !dragHandle)) return;

		draggedTile = tile as HTMLDivElement;
		activePointerId = event.pointerId;
		pointerMoved = false;
		pointerStart = { x: event.clientX, y: event.clientY };
		draggedTile.classList.add('is-reordering');
		board.classList.add('is-reordering');
		board.setPointerCapture(event.pointerId);
		event.preventDefault();
	});

	board?.addEventListener('pointermove', (event) => {
		if (!draggedTile || event.pointerId !== activePointerId) return;
		const x = event.clientX - pointerStart.x;
		const y = event.clientY - pointerStart.y;
		if (Math.hypot(x, y) > 5) pointerMoved = true;
		if (pointerMoved) draggedTile.style.transform = `translate(${x}px, ${y}px) scale(1.03)`;
	});

	board?.addEventListener('pointerup', (event) => finishReordering(event, true));
	board?.addEventListener('pointercancel', (event) => finishReordering(event, false));

	type ExportQuality = 'low' | 'medium' | 'original';
	type ExportFormat = 'png' | 'jpeg';

	async function createExportBlob(quality: ExportQuality, format: ExportFormat, clipboard = false): Promise<Blob> {
		if (!board) throw new Error('The image board is unavailable.');

		const images = Array.from(board.querySelectorAll('img'));
		if (images.length === 0) throw new Error('Add at least one image before exporting.');
		await Promise.all(images.map((image) => image.decode()));

		const columns = Math.ceil(Math.sqrt(images.length));
		const remainder = images.length % columns;
		const firstRowOffset = remainder === 0 ? 0 : Math.ceil((columns - remainder) / 2);
		const rows = Math.ceil((firstRowOffset + images.length) / columns);
		const originalTileSize = Math.max(...images.map((image) => Math.max(image.naturalWidth, image.naturalHeight)));
		const tileSize = quality === 'low' ? 320 : quality === 'medium' ? 800 : originalTileSize;
		const gap = Math.round(tileSize * 0.04);
		const padding = gap;
		const canvas = document.createElement('canvas');
		canvas.width = columns * tileSize + (columns - 1) * gap + padding * 2;
		canvas.height = rows * tileSize + (rows - 1) * gap + padding * 2;
		if (canvas.width > 32767 || canvas.height > 32767 || canvas.width * canvas.height > 64_000_000) {
			throw new Error('This export is too large for the browser. Choose Medium or Low quality.');
		}

		const context = canvas.getContext('2d');
		if (!context) throw new Error('Could not prepare the reference image.');
		const fillBackground = format === 'jpeg';
		if (fillBackground) {
			context.fillStyle = backgroundInput?.value ?? '#808080';
			context.fillRect(0, 0, canvas.width, canvas.height);
		}

		images.forEach((image, index) => {
			const slot = firstRowOffset + index;
			const column = slot % columns;
			const row = Math.floor(slot / columns);
			const scale = Math.min(
				tileSize / image.naturalWidth,
				tileSize / image.naturalHeight,
				quality === 'original' ? 1 : Number.POSITIVE_INFINITY
			);
			const width = image.naturalWidth * scale;
			const height = image.naturalHeight * scale;
			const x = padding + column * (tileSize + gap) + (tileSize - width) / 2;
			const y = padding + row * (tileSize + gap) + (tileSize - height) / 2;
			context.drawImage(image, x, y, width, height);
		});

		const mimeType = clipboard || format === 'png' ? 'image/png' : 'image/jpeg';
		const jpegQuality = quality === 'low' ? 0.55 : quality === 'medium' ? 0.82 : 0.95;
		return new Promise((resolve, reject) => {
			canvas.toBlob(
				(blob) => blob ? resolve(blob) : reject(new Error('The browser could not create the image. Try a lower quality.')),
				mimeType,
				jpegQuality
			);
		});
	}

	function showExportStatus(message: string) {
		if (exportStatus) exportStatus.textContent = message;
	}

	exportButton?.addEventListener('click', () => {
		showExportStatus(board?.querySelector('img') ? '' : 'Add at least one image before exporting.');
		exportDialog?.showModal();
	});

	closeExportButton?.addEventListener('click', () => exportDialog?.close());

	downloadButton?.addEventListener('click', async () => {
		try {
			const quality = (qualityInput?.value ?? 'medium') as ExportQuality;
			const format = (formatInput?.value ?? 'png') as ExportFormat;
			const blob = await createExportBlob(quality, format);
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = `artref.${format === 'jpeg' ? 'jpg' : 'png'}`;
			document.body.appendChild(link);
			link.click();
			link.remove();
			window.setTimeout(() => URL.revokeObjectURL(url), 1000);
			showExportStatus('Reference image downloaded.');
		} catch (error) {
			showExportStatus(error instanceof Error ? error.message : 'Could not export the reference image.');
		}
	});

	copyButton?.addEventListener('click', async () => {
		try {
			if (!navigator.clipboard?.write || typeof ClipboardItem === 'undefined') {
				throw new Error('Image clipboard access is not available in this browser.');
			}
			const quality = (qualityInput?.value ?? 'medium') as ExportQuality;
			const format = (formatInput?.value ?? 'png') as ExportFormat;
			const blob = await createExportBlob(quality, format, true);
			await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
			showExportStatus('Reference image copied to the clipboard as PNG.');
		} catch (error) {
			showExportStatus(error instanceof Error ? error.message : 'Could not copy the reference image.');
		}
	});
</script>

<style>
	:global(:root) { --ink: #20302c; --paper: #f5f6ef; --lime: #b8d654; --coral: #d77960; --line: #d8dfd5; --display: Georgia, 'Times New Roman', serif; --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; }
	:global(body) { background: var(--paper); color: var(--ink); font-family: 'Trebuchet MS', Verdana, sans-serif; }.components-page { max-width: 1220px; margin: auto; padding: 0 42px; }.topbar { display: flex; align-items: center; min-height: 76px; border-bottom: 1px solid var(--line); gap: 40px; font: 11px var(--mono); }.brand { display: flex; align-items: center; gap: 9px; color: var(--ink); text-decoration: none; font-weight: 700; letter-spacing: -.06em; }.brand-mark { display: grid; place-items: center; width: 23px; height: 23px; color: var(--ink); background: var(--lime); font-size: 17px; }.brand-slash { color: var(--coral); }nav { display: flex; gap: 25px; margin-left: 12px; }nav a { color: #728078; text-decoration: none; }nav a:hover, nav a.current { color: var(--ink); }.edition { margin-left: auto; color: #a0aaa3; font-size: 10px; }.page-intro { max-width: 780px; padding: 102px 8% 95px; }.kicker { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--coral); font: 700 10px var(--mono); letter-spacing: .13em; text-transform: uppercase; }.kicker span { display: inline-block; width: 22px; height: 1px; background: currentColor; }h1, h2 { margin: 18px 0 0; color: var(--ink); font: 400 clamp(58px, 9vw, 116px)/.9 var(--display); letter-spacing: -.055em; }h1 em, h2 em { color: var(--coral); font-style: italic; }.lede { max-width: 500px; margin: 29px 0 0 4px; color: #68766f; font-size: 16px; line-height: 1.7; }.lab-section { padding-bottom: 125px; }.section-heading { display: flex; align-items: end; justify-content: space-between; margin: 0 8% 38px; }.section-heading h2, .notes h2 { font-size: clamp(43px, 6vw, 72px); }.section-heading .kicker { margin-bottom: 7px; }.section-note { margin: 0 0 6px; color: #89958d; font: 11px/1.7 var(--mono); text-align: right; }.notes { display: grid; grid-template-columns: .65fr 1fr; gap: 10%; padding: 85px 8% 95px; border-top: 1px solid var(--line); }.note-list { border-top: 1px solid var(--line); }.note { display: grid; grid-template-columns: 38px 1fr; gap: 14px; padding: 20px 0; border-bottom: 1px solid var(--line); }.note > span { color: var(--coral); font: 10px var(--mono); }.note strong { font-size: 14px; }.note p { margin: 6px 0 0; color: #7a877f; font-size: 12px; line-height: 1.6; }footer { display: flex; justify-content: space-between; padding: 22px 0 35px; color: #919b94; font: 10px var(--mono); }footer a { color: var(--ink); text-decoration: none; }footer a:hover { color: var(--coral); }
	@media (max-width: 700px) { .components-page { padding: 0 20px; }.topbar { gap: 15px; }.topbar nav { display: none; }.edition { font-size: 9px; text-align: right; }.page-intro { padding: 75px 0 75px; }.section-heading { display: block; margin: 0 0 28px; }.section-heading h2 { margin-top: 15px; }.section-note { margin-top: 22px; text-align: left; }.lab-section { padding-bottom: 85px; }.notes { display: block; padding: 65px 0 70px; }.note-list { margin-top: 38px; }footer { gap: 20px; flex-wrap: wrap; } }
</style>
