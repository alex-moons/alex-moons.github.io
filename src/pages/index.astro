---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resources = [
	{ label: 'Astro docs', href: 'https://docs.astro.build', note: 'The island architecture' },
	{ label: 'Svelte docs', href: 'https://svelte.dev/docs/svelte/overview', note: 'Reactive components' },
	{ label: 'GitHub Pages', href: 'https://docs.astro.build/en/guides/deploy/github/', note: 'Static deployment' }
];
---

<Layout>
	<div class="page-grid">
		<header class="topbar">
			<a class="topbar-icon" href="/" aria-label="alexmoons home"><img src="../../public/favicon.svg"></a>
			<nav aria-label="Main navigation">
				<a href="#projects">Projects</a>
				<a href={`${base}/testing`}>Testing</a>
				<a href={`${base}/artref`}>ArtRef</a>
			</nav>
			<span class="edition">A professional website to get to know me</span>
			<button id="theme-toggle" type="button" aria-label="Toggle dark mode">◐</button>
		</header>

		<main class="main">
			<section class="main-panel panel">
				<h1>Alejandro Hernández</h1>
				<p>Welcome to my personal website</p>
			</section>
			<section class="side-panel panel">
				<h3>this is the side</h3>
			</section>
