---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
	{ title: 'ArtRef', text: 'A tool for building art reference artboards.', href: `${base}/artref`, tag: 'Web tool' },
	{ title: 'iOS finance tool', text: 'An ios app to manage personal finances.', tag: 'iOS' },
	{ title: 'Flowergame', text: 'An idle game made in Godot.', tag: 'Game' },
	{ title: 'Little Duck', text: 'A compiler for a custom language, written during my degree.', tag: 'Compiler' }
];

const timeline = [
	{ when: 'Jan 2026 to now', title: 'Full-stack developer and tech lead', place: 'Siemens', text: 'Lead web development and manage the Sphere website.' },
	{ when: 'Mar 2025 to Jan 2026', title: 'Frontend developer', place: 'Siemens', text: 'Full-time on Sphere, working in HTML, CSS and JavaScript.' },
	{ when: 'May 2024 to Mar 2025', title: 'Graduate associate', place: 'Siemens', text: 'Started on the Sphere team right after graduating.' },
	{ when: 'Sep to Dec 2023', title: 'Exchange semester', place: 'University of Toronto', text: 'Art and history courses.' },
	{ when: 'Aug 2020 to Jun 2024', title: 'B.S. in Computer Technology Engineering', place: 'Tecnológico de Monterrey', text: 'Graduated with a CGPA of 94.46/100.' }
];

const now = ['ArtRef, the artboard creator', 'Flowergame', 'This website'];
const latestThought = 'Twitter should come back stronger than ever without all the toxicity.';
---

<Layout>
	<div class="page-grid">
		<header class="topbar">
			<a class="topbar-icon" href={`${base}/`} aria-label="alexmoons home">
				<img src={`${base}/favicon.svg`} alt="" width="24" height="24" />
			</a>
			<nav aria-label="Main navigation">
				<button class="nav-toggle" type="button">
					Menu <span class="caret" aria-hidden="true"></span>
				</button>
				<div class="nav-links">
					<a href={`${base}/#projects`}>Projects</a>
					<a href={`${base}/testing`}>Testing</a>
					<a href={`${base}/artref`}>ArtRef</a>
				</div>
			</nav>
			<span class="edition">A professional website to get to know me</span>
			<button id="theme-toggle" type="button" aria-label="Toggle dark mode">◐</button>
		</header>

		<main class="main">
			<div class="main-panel">
				<section class="hero">
					<div>
						<h1>Alejandro Hernández</h1>
						<p class="role">Full-stack developer and tech lead at Siemens, based in Monterrey, Mexico.</p>
						<p>
							I manage the Sphere website, working across the web and on iOS apps in Swift.
							Outside work I build tools and games.
						</p>
						<p class="stack">
							<strong>Works with</strong>
							HTML, CSS, JavaScript, C#, Swift and SwiftUI, Supabase, Firebase, Azure, Astro, Svelte, Godot
						</p>
						<p class="actions">
							<a class="button" href="#projects">See projects</a>
							<a class="button ghost" href={`${base}/CV.pdf`} download>Download CV</a>
						</p>
					</div>
					<img class="profile-pic" src={`${base}/src/assets/profile.jpeg`} alt="Alejandro Hernández" />
				</section>	

				<section id="projects">
					<h2>Projects</h2>
					<div class="project-list">
						{projects.map((p) => (
							<article class="project">
								<h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
								<p>{p.text}</p>
								<span class="tag">{p.tag}</span>
							</article>
						))}
					</div>
				</section>

				<section id="timeline">
					<h2>Work and study</h2>
					<ol class="timeline">
						{timeline.map((t) => (
							<li>
								<p class="when">{t.when}</p>
								<p class="what"><strong>{t.title}</strong>, {t.place}</p>
								<p>{t.text}</p>
							</li>
						))}
					</ol>
				</section>
			</div>

			<aside class="side-panel" aria-label="Currently">
				<section>
					<h2 class="side-title">Now working on</h2>
					<ul>
						{now.map((item) => <li>{item}</li>)}
					</ul>
				</section>
				<section>
					<h2 class="side-title">Latest thought</h2>
					<p>{latestThought}</p>
				</section>
				<section>
					<h2 class="side-title">Local time</h2>
					<p>Monterrey: <span id="local-time">--:--</span></p>
				</section>
			</aside>
		</main>

		<footer><span>Made with Astro and Svelte</span><span>Thanks for checking it out!</span></footer>
	</div>
</Layout>

<style>
	.page-grid {
		--font-display: Georgia, 'Times New Roman', serif;
		max-width: 1220px;
		margin: auto;
		padding: 0 42px;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--color-link);
		outline-offset: 3px;
	}

	/* Header */
	.topbar {
		display: flex;
		align-items: center;
		gap: 20px;
		min-height: 76px;
		border-bottom: 1px solid var(--color-line);
		font: 11px var(--font-mono);
	}
	.topbar-icon img { display: block; }
	.edition { margin-left: auto; opacity: 0.6; font-size: 10px; }

	#theme-toggle {
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--color-line);
		border-radius: 50%;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	/* Nav: horizontal row, dropdown below 560px */
	nav { position: relative; margin-left: 12px; }
	.nav-toggle { display: none; }
	.nav-links { display: flex; gap: 25px; }
	nav a { color: var(--color-text); text-decoration: none; opacity: 0.75; }
	nav a:hover,
	nav a:focus-visible { color: var(--color-link); opacity: 1; }

	@media (max-width: 560px) {
		.nav-toggle {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 0;
			border: 0;
			background: none;
			font: inherit;
			color: var(--color-text);
			cursor: pointer;
		}
		.caret {
			width: 0;
			height: 0;
			border-left: 4px solid transparent;
			border-right: 4px solid transparent;
			border-top: 6px solid currentColor;
			transition: transform 0.2s ease;
		}
		nav:focus-within .caret { transform: rotate(180deg); }

		.nav-links {
			position: absolute;
			top: calc(100% + 8px);
			left: 0;
			z-index: 10;
			flex-direction: column;
			gap: 0;
			min-width: 160px;
			padding: 4px;
			background: var(--color-bg);
			border: 1px solid var(--color-line);
			border-radius: 8px;
			opacity: 0;
			visibility: hidden;
			transform: translateY(-6px);
			transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
		}
		.nav-links a { padding: 10px 12px; border-radius: 6px; }
		.nav-links a:hover { background: var(--color-surface); }

		nav:focus-within .nav-links {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition-delay: 0s;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret, .nav-links { transition: none; }
	}

	/* Layout: single column, main + side rail from 900px */
	.main { display: grid; gap: 3rem; padding: 3rem 0 4rem; }
	.main-panel { display: grid; gap: 4rem; min-width: 0; }

	@media (min-width: 900px) {
		.main { grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr); gap: 4rem; }
		.side-panel { position: sticky; top: 1.5rem; align-self: start; }
	}

	/* Type */
	h1, h2 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	h1 { font-size: clamp(2.6rem, 6vw, 4.5rem); }
	h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); }
	p { max-width: 62ch; line-height: 1.65; margin: 0 0 1rem; }

	/* Hero */
	.hero { display: flex; gap: 2rem; align-items: center; }
	.profile-pic {
		display: block;
		width: 180px;
		aspect-ratio: 1;
		height: 180px;
		border-radius: 50%;
		object-fit: cover;
	}
	.role { font-size: 1.2rem; }
	.stack { font-size: 0.9rem; }
	.stack strong { display: block; font-weight: 600; }
	.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 1.5rem; }
	.button {
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--color-accent);
		border-radius: 6px;
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.button.ghost { background: none; color: var(--color-text); border-color: var(--color-line); }
	.button:hover { filter: brightness(0.95); }

	/* Projects */
	.project-list { display: grid; gap: 1.75rem 2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
	.project { padding-top: 0.75rem; border-top: 2px solid var(--color-line); }
	.project h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
	.project h3 a { color: var(--color-link); }
	.project p { margin-bottom: 0.5rem; }
	.tag { font: 11px var(--font-mono); opacity: 0.7; }

	/* Timeline */
	.timeline {
		display: grid;
		gap: 1.75rem;
		margin: 0;
		padding: 0 0 0 1.5rem;
		list-style: none;
		border-left: 1px solid var(--color-line);
	}
	.timeline li { position: relative; }
	.timeline li::before {
		content: '';
		position: absolute;
		left: calc(-1.5rem - 4.5px);
		top: 0.4rem;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
	}
	.timeline p { margin: 0 0 0.25rem; }
	.when { font: 11px var(--font-mono); opacity: 0.7; }

	/* Side panel */
	.side-panel {
		display: grid;
		gap: 1.75rem;
		padding: 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: 8px;
	}
	.side-title { margin-bottom: 0.5rem; font-size: 1.25rem; }
	.side-panel ul { margin: 0; padding-left: 1.1rem; line-height: 1.7; }
	.side-panel p { margin: 0; }

	footer {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 20px;
		padding: 22px 0 35px;
		border-top: 1px solid var(--color-line);
		font: 10px var(--font-mono);
		opacity: 0.7;
	}

	@media (max-width: 700px) {
		.page-grid { padding: 0 20px; }
		.edition { display: none; }
		#theme-toggle { margin-left: auto; }
	}
</style>

<script>
	const root = document.documentElement;
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const current =
			root.dataset.theme ??
			(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const next = current === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try { localStorage.setItem('theme', next); } catch {}
	});

	const clock = document.getElementById('local-time');
	if (clock) {
		const fmt = new Intl.DateTimeFormat('en', {
			hour: 'numeric',
			minute: '2-digit',
			timeZone: 'America/Monterrey'
		});
		const tick = () => { clock.textContent = fmt.format(new Date()); };
		tick();
		setInterval(tick, 30000);
	}
</script>